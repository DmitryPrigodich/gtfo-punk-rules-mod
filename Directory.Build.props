<Project>
  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <DebugType>embedded</DebugType>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <!-- Folder with BepInEx/core + BepInEx/interop. Defaults to lib/ next to this file; an r2modman profile can be given: -p:GameLibs=... -->
    <GameLibs Condition="'$(GameLibs)' == ''">$(MSBuildThisFileDirectory)lib</GameLibs>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="$(GameLibs)/*.dll" Private="false" />
    <Reference Remove="$(GameLibs)/netstandard.dll" />
    <Compile Include="$(MSBuildThisFileDirectory)Shared/**/*.cs" />
  </ItemGroup>
</Project>
